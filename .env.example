# Copia este archivo como .env y completa los valores.
# Este archivo NO contiene secretos: la autenticación es con Entra ID (az login).

# Endpoint del recurso (Foundry > tu recurso > Endpoint). Sin /openai/v1 al final.
# Ambos formatos funcionan:
#   https://<recurso>.openai.azure.com
#   https://<recurso>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=

# Nombre del DEPLOYMENT 
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Esfuerzo de razonamiento: minimal | low | medium | high
REASONING_EFFORT=low
